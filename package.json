{
  "name": "mixd-case-studio",
  "version": "0.1.0",
  "private": true,
  "description": "An extensible, print-ready custom phone-case design studio built for Cloudflare Workers.",
  "license": "MIT",
  "keywords": [
    "phone-case",
    "customizer",
    "cloudflare-workers",
    "d1",
    "r2",
    "nextjs"
  ],
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --port 3000",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260921.1",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "react-server-dom-webpack": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "type": "module"
}
